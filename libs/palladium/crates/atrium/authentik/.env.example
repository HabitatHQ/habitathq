# Copy to .env and replace both values with locally generated secrets.
# Never commit .env or use these placeholders outside local development.
PG_DB=authentik
PG_USER=authentik
PG_PASS=replace-with-a-local-postgres-password
AUTHENTIK_SECRET_KEY=replace-with-a-long-random-secret-key

# Loopback-only host ports.
AUTHENTIK_HTTP_PORT=9000
AUTHENTIK_HTTPS_PORT=9443

# Stable values consumed by Atrium and Burrow during local OIDC development.
ATRIUM_OIDC_ISSUER=http://127.0.0.1:9000/application/o/atrium/
ATRIUM_OIDC_DISCOVERY_URL=http://127.0.0.1:9000/application/o/atrium/.well-known/openid-configuration
ATRIUM_OIDC_JWKS_URL=http://127.0.0.1:9000/application/o/atrium/jwks/
ATRIUM_OIDC_CLIENT_ID=atrium-local
ATRIUM_OIDC_ALLOW_INSECURE_LOOPBACK=true
ATRIUM_OIDC_REDIRECT_URI=http://127.0.0.1:5173/auth/callback
