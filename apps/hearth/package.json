{
  "name": "hearth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "dev:pwa": "BUILD_TARGET=pwa nuxt dev",
    "build:pwa": "BUILD_TARGET=pwa nuxt generate",
    "build:native": "BUILD_TARGET=native nuxt generate && cap sync",
    "preview:pwa": "BUILD_TARGET=pwa nuxt generate && pnpm dlx serve .output/public",
    "clean": "rm -rf .output .nuxt",
    "fetch:assets": "node scripts/fetch-offline-assets.mjs",
    "prebuild:native": "pnpm fetch:assets",
    "postinstall": "nuxt prepare",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "cap:run:android": "cap run android",
    "cap:run:ios": "cap run ios",
    "cap:sync": "cap sync",
    "cap:copy": "cap copy",
    "typecheck": "tsgo --noEmit",
    "typecheck:vue": "nuxt typecheck",
    "typecheck:all": "tsgo --noEmit && nuxt typecheck",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --config playwright.a11y.config.ts",
    "test": "vitest run && playwright test",
    "ci": "pnpm check && pnpm typecheck && pnpm test:unit",
    "verify": "pnpm ci"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/local-notifications": "^8.3.1",
    "@habitathq/db": "workspace:*",
    "@habitathq/shared": "workspace:*",
    "@habitathq/utils": "workspace:*",
    "@huggingface/transformers": "^4.3.0",
    "@nuxt/ui": "^4.11.3",
    "@palladium/core": "workspace:*",
    "@palladium/nuxt": "workspace:*",
    "@palladium/sqlite-browser": "workspace:*",
    "@palladium/sqlite-capacitor": "workspace:*",
    "@sqlite.org/sqlite-wasm": "3.51.2-build6",
    "echarts": "^6.1.0",
    "fflate": "^0.8.3",
    "nuxt": "~4.5.2",
    "tesseract.js": "^7.0.0",
    "vue": "^3.5.43",
    "vue-echarts": "^8.3.1",
    "vue-router": "latest"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@iconify-json/lucide": "^1.2.138",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.5",
    "rollup-plugin-license": "^3.7.1",
    "tailwindcss": "^4.3.3",
    "vitest": "^4.1.11",
    "workbox-build": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
