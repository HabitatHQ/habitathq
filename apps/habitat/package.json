{
  "name": "habitat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @palladium/worker build",
    "dev": "nuxt dev",
    "dev:pwa": "BUILD_TARGET=pwa nuxt dev",
    "build:pwa": "BUILD_TARGET=pwa nuxt generate",
    "build:native": "BUILD_TARGET=native nuxt generate && cap sync",
    "preview:pwa": "BUILD_TARGET=pwa nuxt generate && pnpm dlx serve .output/public",
    "clean": "rm -rf .output .nuxt",
    "postinstall": "nuxt prepare",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "cap:run:android": "cap run android",
    "cap:run:ios": "cap run ios",
    "cap:sync": "cap sync",
    "cap:copy": "cap copy",
    "gradle": "cd android && ./gradlew",
    "pretypecheck": "pnpm --filter @palladium/worker build",
    "typecheck": "tsgo --noEmit",
    "typecheck:vue": "nuxt typecheck",
    "typecheck:all": "tsgo --noEmit && nuxt typecheck",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "vitest run --config vitest.config.a11y.ts && playwright test --config playwright.a11y.config.ts",
    "test:a11y:unit": "vitest run --config vitest.config.a11y.ts",
    "test:a11y:e2e": "playwright test --config playwright.a11y.config.ts",
    "test": "vitest run && playwright test",
    "ci": "pnpm run check && pnpm run typecheck:all && pnpm run test:unit",
    "verify": "pnpm run ci",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@habitathq/shared": "workspace:*",
    "@habitathq/utils": "workspace:*",
    "@nuxt/ui": "^4.11.3",
    "@palladium/core": "workspace:*",
    "@palladium/sqlite-browser": "workspace:*",
    "@palladium/sqlite-capacitor": "workspace:*",
    "@palladium/worker": "workspace:*",
    "@sqlite.org/sqlite-wasm": "3.51.2-build6",
    "comlink": "^4.4.2",
    "fflate": "^0.8.3",
    "nuxt": "~4.5.2",
    "vue": "^3.5.43",
    "vue-router": "latest"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@iconify-json/lucide": "^1.2.138",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "coi-serviceworker": "^0.1.7",
    "happy-dom": "^20.14.5",
    "rollup-plugin-license": "^3.7.1",
    "tailwindcss": "^4.3.3",
    "unplugin-auto-import": "^21.1.0",
    "vitest": "^4.1.11",
    "workbox-build": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
